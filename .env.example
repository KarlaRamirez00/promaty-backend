EUREKA_PORT=8761
USER_PORT=8081
AUTH_PORT=8082
RRHH_PORT=8085
GATEWAY_PORT=8083

DB_USERNAME=postgres
DB_PASSWORD=changeme

JWT_SECRET=changeme
JWT_EXPIRATION_MS=28800000

# Secreto de servicio para /internal/** (user-server y authorizer-server). Minimo 32 caracteres; sin el, user-server no arranca.
INTERNAL_API_SECRET=changeme-changeme-changeme-changeme
# Solo al rotar: user-server acepta ambos secretos mientras se actualizan los clientes.
# INTERNAL_API_SECRET_NEXT=

MAIL_ENABLED=false
MAIL_FROM=no-reply@promaty.local
# Solo si MAIL_ENABLED=true:
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

CORS_ALLOWED_ORIGINS=http://localhost:5173
